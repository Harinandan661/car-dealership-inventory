generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
  role     String @default("USER")
}

model Vehicle {
  id       String @id @default(cuid())
  make     String
  model    String
  category String
  price    Float
  quantity Int
}
